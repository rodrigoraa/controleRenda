# Gere este arquivo com: sh scripts/configure.sh
APP_DOMAIN=financas.seudominio.com
APP_ORIGIN=https://financas.seudominio.com
# Use uma senha hexadecimal aleatória. Não deixe este valor vazio.
POSTGRES_PASSWORD=
APP_DB_PASSWORD=
# Porta exposta somente em 127.0.0.1 para um proxy reverso existente.
APP_PORT=3000
LOG_LEVEL=info
