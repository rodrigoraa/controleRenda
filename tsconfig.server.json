{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "types": ["node"]
  },
  "include": [
    "server/**/*.ts",
    "src/lib/finance.ts",
    "src/lib/types.ts",
    "src/lib/validation.ts",
    "tests/server/**/*.ts",
    "tsup.config.ts"
  ]
}
